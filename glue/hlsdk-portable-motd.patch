diff --git a/cl_dll/hud.cpp b/cl_dll/hud.cpp
index e84034b..d11eb93 100644
--- a/cl_dll/hud.cpp
+++ b/cl_dll/hud.cpp
@@ -214,6 +214,19 @@ int __MsgFunc_MOTD(const char *pszName, int iSize, void *pbuf)
        bool finished = gHUD.m_MOTD.HandleMOTDMessage(pszName, iSize, pbuf);
        if (finished)
        {
+#ifdef XASH_ANDROID
+               // render the MOTD in the engine's sandboxed WebView dialog, just
+               // like the CS 1.6 client does on Android (the export is appended
+               // at the end of cl_enginefunc_t and stays NULL on engines that
+               // don't provide it). If the dialog cannot be shown, fall through
+               // to the classic HUD text renderer so the MOTD is never lost
+               // even on engines without the dialog.
+               if (gEngfuncs.pfnShowMOTD && gEngfuncs.pfnShowMOTD(gHUD.m_MOTD.m_szMOTD))
+               {
+                       gHUD.m_MOTD.Reset();
+                       return 1;
+               }
+#endif
                if (gHUD.UseVguiMOTD() && gViewPort)
                {
                        gViewPort->ShowMOTD();
diff --git a/cl_dll/hud.h b/cl_dll/hud.h
