 #define MAX_SERVERNAME_LENGTH  64
 #define MAX_TEAMNAME_SIZE 32
diff --git a/engine/cdll_int.h b/engine/cdll_int.h
index 6462049..123314e 100644
--- a/engine/cdll_int.h
+++ b/engine/cdll_int.h
@@ -306,6 +306,17 @@ typedef struct cl_enginefuncs_s
 
        // added in 2019 update, not documented yet
        int             (*pfnFilteredClientCmd)( const char *cmd );
+
+       // show an HTML "MOTD" user message in a
+       // sandboxed platform dialog (Android: WebView). Returns true when the
+       // dialog is on screen, false so the client dll can use its own HUD
+       // fallback. Appending here is ABI-safe: client dlls built against
+       // older headers simply copy a smaller struct.
+       int     (*pfnShowMOTD)( const char *html );
+
+       // true while the platform MOTD dialog is on
+       // screen (used by the CS client to defer the team select menu).
+       int     (*pfnIsMOTDDialogActive)( void );
 } cl_enginefunc_t;
 
 #define CLDLL_INTERFACE_VERSION        7
